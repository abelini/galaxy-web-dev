---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
}
const { eyebrow, title, desc } = Astro.props;
---
<div class="max-w-2xl mx-auto text-center mb-12">
  <span class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-cyan-300 bg-cyan-400/10 border border-cyan-400/20 rounded-full px-4 py-1.5">
    {eyebrow}
  </span>
  <h2 class="font-[Space_Grotesk] text-3xl sm:text-4xl font-bold text-white mt-4 leading-tight" set:html={title} />
  {desc && <p class="text-slate-400 mt-4 text-lg">{desc}</p>}
</div>
