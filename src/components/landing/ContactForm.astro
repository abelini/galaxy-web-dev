---
import SectionHeading from './SectionHeading.astro';

// Sitekey pública (no es secreta). En prod pon tu sitekey real vía
// variable de entorno PUBLIC_TURNSTILE_SITE_KEY. Por defecto usa la
// key de test de Cloudflare (siempre pasa, solo para dev).
const TURNSTILE_SITE_KEY =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA";
---
<section id="contacto" class="py-20 px-5 scroll-mt-16 border-t border-white/5">
  <div class="max-w-3xl mx-auto">
    <SectionHeading eyebrow="Contacto" title="Pide tu presupuesto gratis" desc="Cuéntanos qué necesitas y te respondemos en menos de 24h laborables." />
    <form
      id="contact-form"
      class="bg-white/[0.04] border border-white/10 rounded-3xl p-6 sm:p-8 grid gap-4"
      novalidate
    >
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="grid gap-1.5 text-sm">
          <span class="text-slate-300 font-medium">Nombre *</span>
          <input required name="nombre" type="text" autocomplete="name" placeholder="Tu nombre"
            class="bg-black/40 border border-white/15 focus:border-cyan-300/60 rounded-xl px-4 py-3 text-white placeholder:text-slate-500 outline-none transition" />
        </label>
        <label class="grid gap-1.5 text-sm">
          <span class="text-slate-300 font-medium">Email *</span>
          <input required name="email" type="email" autocomplete="email" placeholder="tu@email.com"
            class="bg-black/40 border border-white/15 focus:border-cyan-300/60 rounded-xl px-4 py-3 text-white placeholder:text-slate-500 outline-none transition" />
        </label>
      </div>
      <label class="grid gap-1.5 text-sm">
        <span class="text-slate-300 font-medium">Servicio que necesitas *</span>
        <select required name="servicio" class="bg-black/40 border border-white/15 focus:border-cyan-300/60 rounded-xl px-4 py-3 text-white outline-none transition">
          <option value="">Selecciona…</option>
          <option>Hospedaje web</option>
          <option>Diseño web</option>
          <option>Desarrollo web</option>
          <option>App Android</option>
          <option>Streaming audio / video</option>
          <option>Proyecto completo</option>
        </select>
      </label>
      <label class="grid gap-1.5 text-sm">
        <span class="text-slate-300 font-medium">Cuéntanos tu proyecto *</span>
        <textarea required name="mensaje" rows={5} placeholder="Ej: necesito web para mi negocio + hosting y radio online…"
          class="bg-black/40 border border-white/15 focus:border-cyan-300/60 rounded-xl px-4 py-3 text-white placeholder:text-slate-500 outline-none transition resize-y"></textarea>
      </label>
      <div class="flex justify-center py-1">
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="dark"></div>
      </div>
      <p id="form-error" class="hidden text-sm text-red-300"></p>
      <button id="contact-submit" type="submit" class="font-semibold text-white bg-gradient-to-r from-violet-600 to-cyan-500 hover:from-violet-500 hover:to-cyan-400 rounded-full px-7 py-3.5 transition shadow-xl shadow-violet-600/30 disabled:opacity-50">
        Enviar solicitud
      </button>
      <p class="text-center text-sm text-slate-500">
        ¿Prefieres email? <a id="contact-mailto" class="text-cyan-300 hover:underline" href="#"><span class="email-rev">ved.bewyxalag@selas</span></a>
      </p>
      <div id="form-ok" class="hidden text-center bg-emerald-400/10 border border-emerald-300/30 rounded-2xl p-6">
        <p class="text-emerald-200 font-semibold text-lg"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> ¡Solicitud enviada!</p>
        <p class="text-slate-300 mt-1 text-sm">La hemos recibido. Te responderemos en &lt;24h laborables.</p>
      </div>
    </form>
  </div>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  /* Truco anti-crawlers: el email va invertido en el HTML y se muestra derecho */
  .email-rev {
    unicode-bidi: bidi-override;
    direction: rtl;
  }
</style>

<script>
  // Reconstruye el mailto desde el texto invertido (el email en claro nunca sale en el HTML)
  const mailtoEl = document.getElementById('contact-mailto') as HTMLAnchorElement | null;
  const revText = mailtoEl?.querySelector('.email-rev')?.textContent?.trim() || '';
  if (mailtoEl && revText) {
    mailtoEl.setAttribute('href', 'mailto:' + [...revText].reverse().join(''));
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const err = document.getElementById('form-error');
  const ok = document.getElementById('form-ok');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  const showError = (m: string) => {
    if (!err) return;
    err.textContent = m;
    err.classList.remove('hidden');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;
    err?.classList.add('hidden');
    ok?.classList.add('hidden');

    const data = new FormData(form);
    const nombre = String(data.get('nombre') || '').trim();
    const email = String(data.get('email') || '').trim();
    const servicio = String(data.get('servicio') || '');
    const mensaje = String(data.get('mensaje') || '').trim();
    const turnstileToken = (
      document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null
    )?.value?.trim() || '';

    if (nombre.length < 2) return showError('Escribe tu nombre.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Escribe un email válido.');
    if (!servicio) return showError('Selecciona un servicio.');
    if (mensaje.length < 10) return showError('Cuéntanos un poco más (mín. 10 caracteres).');
    if (!turnstileToken) return showError('Completa la verificación anti-spam.');

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, email, servicio, mensaje, turnstileToken }),
      });
      const out = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (!res.ok || !out.ok) {
        showError(out.error || 'No se pudo enviar. Inténtalo más tarde.');
        return;
      }
      ok?.classList.remove('hidden');
      form.reset();
    } catch {
      showError('Error de red. Inténtalo de nuevo.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar solicitud';
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    }
  });
</script>
