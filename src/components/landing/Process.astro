---
import SectionHeading from './SectionHeading.astro';
const steps = [
  { n: "01", t: "Descubrimiento", d: "Llamada de 20 min para entender tu negocio, objetivos y plazos. Sin compromiso." },
  { n: "02", t: "Propuesta", d: "Presupuesto cerrado con diseño, hosting, desarrollo y streaming según lo que necesites." },
  { n: "03", t: "Construcción", d: "Diseño + desarrollo en ciclos cortos. Ves avances reales cada semana." },
  { n: "04", t: "Lanzamiento y soporte", d: "Despliegue en Cloudflare, SSL, analítica y soporte continuo." },
];
---
<section id="proceso" class="py-20 px-5 scroll-mt-16 border-t border-white/5">
  <div class="max-w-6xl mx-auto">
    <SectionHeading eyebrow="Proceso" title="De la idea al lanzamiento en 4 pasos" />
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map((s) => (
        <li class="bg-white/[0.04] border border-white/10 rounded-2xl p-6">
          <span class="font-[Space_Grotesk] text-4xl font-bold bg-gradient-to-r from-violet-400 to-cyan-300 bg-clip-text text-transparent">{s.n}</span>
          <h3 class="font-[Space_Grotesk] text-lg font-bold text-white mt-3">{s.t}</h3>
          <p class="text-slate-400 mt-2 text-[15px] leading-relaxed">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
