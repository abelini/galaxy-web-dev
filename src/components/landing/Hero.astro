---
---
<section id="inicio" class="pt-32 pb-16 sm:pt-40 sm:pb-24 px-5">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <div class="inline-flex items-center gap-2 text-xs text-slate-300 border border-white/15 rounded-full px-4 py-1.5 bg-white/5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Aceptando nuevos proyectos
      </div>
      <h1 class="font-[Space_Grotesk] text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-[1.05] mt-6">
        Creamos tu universo <span class="bg-gradient-to-r from-violet-400 via-fuchsia-300 to-cyan-300 bg-clip-text text-transparent">digital</span>
      </h1>
      <p class="text-slate-400 text-lg mt-6 max-w-xl">
        Hospedaje, diseño, webs responsive, apps Android y streaming de audio y video. Todo lo que tu negocio necesita para despegar, en un solo proveedor.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="#contacto" class="font-semibold text-white bg-gradient-to-r from-violet-600 to-cyan-500 hover:from-violet-500 hover:to-cyan-400 rounded-full px-7 py-3.5 transition shadow-xl shadow-violet-600/30">
          Solicitar presupuesto gratis
        </a>
        <a href="#servicios" class="font-semibold text-white border border-white/20 hover:border-white/40 hover:bg-white/5 rounded-full px-7 py-3.5 transition">
          Ver servicios
        </a>
      </div>
      <dl class="grid grid-cols-3 gap-6 mt-12 max-w-md">
        <div><dt class="font-[Space_Grotesk] text-2xl sm:text-3xl font-bold text-white">+50</dt><dd class="text-xs sm:text-sm text-slate-400 mt-1">Proyectos lanzados</dd></div>
        <div><dt class="font-[Space_Grotesk] text-2xl sm:text-3xl font-bold text-white">99.9%</dt><dd class="text-xs sm:text-sm text-slate-400 mt-1">Uptime hosting</dd></div>
        <div><dt class="font-[Space_Grotesk] text-2xl sm:text-3xl font-bold text-white">24h</dt><dd class="text-xs sm:text-sm text-slate-400 mt-1">Respuesta media</dd></div>
      </dl>
    </div>
    <div class="relative hidden lg:block">
      <div class="absolute -inset-8 bg-gradient-to-br from-violet-600/30 to-cyan-400/20 blur-3xl rounded-full"></div>
      <div class="relative bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur">
        <div class="flex items-center gap-2 mb-6">
          <span class="w-3 h-3 rounded-full bg-red-400"></span>
          <span class="w-3 h-3 rounded-full bg-amber-400"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
        </div>
        <div class="space-y-4 font-mono text-sm">
          <div class="bg-black/40 rounded-xl p-4 border border-white/10">
            <p class="text-slate-500">$ deploy</p>
            <p class="text-emerald-300">✓ web desplegada en 0.8s</p>
            <p class="text-emerald-300">✓ SSL activo · CDN global</p>
          </div>
          <div class="bg-black/40 rounded-xl p-4 border border-white/10">
            <p class="text-slate-500">$ stream status</p>
            <p class="text-cyan-300">● live · 1080p · 240 oyentes</p>
          </div>
          <div class="bg-black/40 rounded-xl p-4 border border-white/10">
            <p class="text-slate-500">$ build android</p>
            <p class="text-emerald-300">✓ APK lista para Play Store</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
